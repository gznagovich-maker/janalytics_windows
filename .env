# ============================================================
# JAnalytics — Configurazione Database PostgreSQL
# Copia questo file in .env e modifica i valori
# ============================================================

# URL di connessione PostgreSQL
# Formato: postgresql://utente:password@host:porta/nome_database
DATABASE_URL=postgresql://janalytics:martinaBestGoomy@localhost:5432/vgc_replays

# Opzioni pool di connessioni (valori consigliati)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
